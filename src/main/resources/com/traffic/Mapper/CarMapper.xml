<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.traffic.Mapper.CarMapper">
<!--    返回所有车辆信息-->
    <select id="getCar">
        SELECT *
        FROM car
    </select>
<!--  修改车辆的state状态-->
    <update id="setCarState">
        UPDATE car
        SET state=#{state}
        WHERE id=#{carId}
    </update>
</mapper>
